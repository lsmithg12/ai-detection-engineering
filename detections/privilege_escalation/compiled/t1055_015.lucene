winlog.channel:Microsoft\-Windows\-Sysmon\/Operational AND ((((event.code:10 AND winlog.event_data.GrantedAccess:0x1FFFFF AND winlog.event_data.TargetImage:*\\svchost.exe) OR (event.code:8 AND winlog.event_data.TargetImage:*\\svchost.exe)) AND (process.executable:(*\\AppData\\* OR *\\Temp\\* OR *\\ProgramData\\* OR *\\Users\\Public\\*)) AND (NOT (process.name:(MsMpEng.exe OR MpCmdRun.exe))) AND (NOT (process.executable:(C\:\\Windows\\System32\\* OR C\:\\Program\ Files\\* OR C\:\\Program\ Files\ \(x86\)\\*)))) OR (event.code:1 AND process.parent.name:svchost.exe AND (process.name:(cmd.exe OR powershell.exe OR wscript.exe OR cscript.exe OR mshta.exe OR rundll32.exe OR regsvr32.exe OR msiexec.exe))))