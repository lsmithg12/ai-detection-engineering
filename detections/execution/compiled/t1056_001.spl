(event.code="7" file.path="*\\user32.dll") OR event.code="1" process.executable IN ("*\\AppData\\*", "*\\ProgramData\\*", "*\\Temp\\*", "*\\Users\\Public\\*") NOT (process.name IN ("osk.exe", "narrator.exe", "magnify.exe", "Utilman.exe")) | table process.name,process.executable,file.path,process.parent.name,user.name,host.name