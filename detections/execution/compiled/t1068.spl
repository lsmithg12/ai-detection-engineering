(event.code="10" winlog.event_data.GrantedAccess="0x1FFFFF" winlog.event_data.TargetImage IN ("*\\winlogon.exe", "*\\lsass.exe") process.executable IN ("*\\AppData\\*", "*\\ProgramData\\*", "*\\Temp\\*", "*\\Users\\Public\\*", "*\\Downloads\\*") NOT (process.executable IN ("C:\\Windows\\System32\\*", "C:\\Windows\\SysWOW64\\*", "C:\\Program Files\\*", "C:\\Program Files (x86)\\*"))) OR (event.code="1" process.executable IN ("*\\AppData\\*", "*\\ProgramData\\*", "*\\Temp\\*", "*\\Users\\Public\\*", "*\\Downloads\\*") NOT (process.executable IN ("C:\\Windows\\System32\\*", "C:\\Windows\\SysWOW64\\*", "C:\\Program Files\\*", "C:\\Program Files (x86)\\*"))) OR (event.code="1" process.command_line IN ("*localgroup administrators*", "*net user /add*")) | table process.name,process.executable,process.command_line,winlog.event_data.GrantedAccess,winlog.event_data.TargetImage,user.name,user.domain,host.name