(event.code="2" process.executable IN ("*\\AppData\\*", "*\\Temp\\*", "*\\ProgramData\\*", "*\\Users\\Public\\*") file.path IN ("*.exe", "*.dll", "*.bat", "*.ps1", "*.cmd", "*.vbs", "*.js")) OR (event.code="1" process.executable IN ("*\\AppData\\*", "*\\Temp\\*", "*\\ProgramData\\*", "*\\Users\\Public\\*") process.command_line="*timestomp*") NOT (process.name IN ("robocopy.exe", "7z.exe", "winrar.exe", "peazip.exe", "tar.exe")) | table process.name,process.executable,process.command_line,file.path,user.name,host.name