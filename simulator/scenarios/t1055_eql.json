{
  "technique_id": "T1055_EQL",
  "technique_name": "Process Injection Sequence - Handle Open Then Remote Thread Creation (EQL)",
  "description": "Simulates the two-step injection sequence: EID 10 (process handle open with PROCESS_ALL_ACCESS) followed within 10s by EID 8 (CreateRemoteThread) on the same host. Covers Fawkes vanilla-injection and apc-injection.",
  "mitre_tactic": "privilege_escalation",
  "log_sources_used": [
    "sysmon_10",
    "sysmon_8"
  ],
  "platforms": [
    "windows"
  ],
  "expected_detection": {
    "should_alert_on": "attack_sequence",
    "should_not_alert_on": "benign_similar",
    "key_fields": [
      "event.code",
      "winlog.event_data.GrantedAccess",
      "process.executable",
      "host.name"
    ],
    "notes": "EQL sequence by host.name — both events MUST share the same host.name and occur within 10s. EID 10 with full access rights from a non-system process, followed by EID 8 from same process. Benign event is a single EID 10 from svchost (filtered) that cannot complete the sequence."
  },
