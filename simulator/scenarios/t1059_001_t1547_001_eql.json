{
  "technique_id": "T1059.001_T1547.001_EQL",
  "technique_name": "PowerShell Execution Followed by Registry Persistence (EQL)",
  "description": "Simulates the Fawkes powershell + persist(registry) attack chain: PowerShell launched with execution policy bypass flags (EID 1) followed within 300s by a registry Run key write (EID 13) on the same host.",
  "mitre_tactic": "execution",
  "log_sources_used": [
    "sysmon_1",
    "sysmon_13"
  ],
  "platforms": [
    "windows"
  ],
  "expected_detection": {
    "should_alert_on": "attack_sequence",
    "should_not_alert_on": "benign_similar",
    "key_fields": [
      "event.code",
      "process.name",
      "process.command_line",
      "registry.path",
      "host.name"
    ],
    "notes": "EQL sequence by host.name with maxspan=300s. Step 1: powershell.exe with bypass flags. Step 2: EID 13 registry write to CurrentVersion\\Run. Benign event is a powershell.exe launch without bypass flags — the command_line pattern won't match the EQL filter."
  },
